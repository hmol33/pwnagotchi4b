[Unit]
Description=pwnagotchi4b self-healing watchdog (runs on every boot)
Documentation=https://github.com/itsdarklikehell/pwnagotchi4b
Wants=network-online.target
After=network-online.target
Before=pwnagotchi.service

[Service]
Type=oneshot
# Invoked via /bin/bash so the script only needs to be readable (robust if /opt
# is mounted noexec). The file is also +x in the repo for direct execution.
ExecStart=/bin/bash /opt/pwnagotchi4b/tools/watchdog.sh
RemainAfterExit=yes
TimeoutStartSec=1800
# Watchdog may legitimately reboot the box; don't let systemd kill it for that.
KillMode=none
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
