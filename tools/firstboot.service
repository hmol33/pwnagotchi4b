[Unit]
Description=pwnagotchi4b headless first-boot setup
Documentation=https://github.com/itsdarklikehell/pwnagotchi4b
Wants=network-online.target
After=network-online.target
Before=pwnagotchi.service
# Only run once: skip if the sentinel flag already exists.
ConditionPathExists=!/var/lib/pwnagotchi4b/.firstboot_done

[Service]
Type=oneshot
# Invoked via /bin/bash so the script only needs to be readable (works even if
# /opt is mounted noexec, e.g. some cloud images). The file is also +x in the
# repo for direct execution on the Pi.
ExecStart=/bin/bash /opt/pwnagotchi4b/tools/firstboot.sh
RemainAfterExit=yes
# apt update + git clones + (optionally) fbcp-ili9341 build can take a while.
TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
